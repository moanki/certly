APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6aa2933f0011fcc722a1
# Runtime key: grant only documents read/write, files read/write, and sessions write.
APPWRITE_API_KEY=
# Local provisioning only: use a separate key with schema, bucket, and user scopes.
APPWRITE_ADMIN_API_KEY=
APPWRITE_DATABASE_ID=certly
APPWRITE_CERTIFICATIONS_COLLECTION_ID=certifications
APPWRITE_PRESETS_COLLECTION_ID=exam_presets
APPWRITE_QUESTIONS_COLLECTION_ID=questions
APPWRITE_ATTEMPTS_COLLECTION_ID=attempts
APPWRITE_ATTEMPT_ANSWERS_COLLECTION_ID=attempt_answers
APPWRITE_IMPORTS_COLLECTION_ID=imports
APPWRITE_IMPORTS_BUCKET_ID=imports

# Used only by npm run appwrite:create-admin. Never configure these on Vercel.
CERTLY_ADMIN_EMAIL=
CERTLY_ADMIN_PASSWORD=
CERTLY_ADMIN_NAME=Certly Admin
